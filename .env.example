# Contoh environment untuk deployment mandiri.
# Simpan nilai rahasia hanya di secret manager deployment.
VITE_SITE_URL=
GEMINI_API_KEY=
# Opsional: dipakai server untuk forced alignment bahasa Indonesia.
# File audio + teks hanya dikirim ke ElevenLabs setelah persetujuan pengguna.
ELEVENLABS_API_KEY=
# Opsional: model Gemini yang dipakai (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
